{"mcp": {
  "laravel-boost": {
    "type": "local",
    "enabled": true,
    "command": [
      "php",
      "artisan",
      "boost:mcp"
    ]
  },
  // Context7 — up-to-date Laravel 13 / React 19 / Vite 5 docs (prevents hallucinated APIs).
  // Priority 1 — highest ROI for code accuracy. No API key required.
  "context7": {
    "type": "local",
    "enabled": true,
    "command": [
      "npx",
      "-y",
      "@upstash/context7-mcp"
    ]
  },
  // Playwright — autonomous UI browsing, screenshots, clicks on https://tamasharoom.test.
  // Priority 1 — critical for UI debugging. No API key required.
  "playwright": {
    "type": "local",
    "enabled": true,
    "command": [
      "npx",
      "-y",
      "@playwright/mcp@latest"
    ]
  },
  // Filesystem — direct read/write in project root (Windows path uses forward slashes).
  // Priority 2 — enables autonomous file editing without copy-paste.
  "filesystem": {
    "type": "local",
    "enabled": true,
    "command": [
      "npx",
      "-y",
      "@modelcontextprotocol/server-filesystem",
      "C:/Users/Khashayar/Documents/TamashaRoom"
    ]
  },
  // SQLite — direct DB queries (EXPLAIN, index checks). Local dev only.
  // NOTE: Native sqlite MCP packages (mcp-sqlite, @mokei/mcp-sqlite) require
  // sqlite3 native bindings that fail on Herd/Windows without build tools.
  // TamashaRoom already exposes DB via laravel-boost's database-query + database-schema
  // tools (verified below) — use those instead. This entry is kept for reference
  // and disabled; enable only if native bindings are fixed.
  // To enable: npx -y @mokei/mcp-sqlite C:/Users/Khashayar/Documents/TamashaRoom/database/database.sqlite
  "sqlite": {
    "type": "local",
    "enabled": false,
    "command": [
      "npx",
      "-y",
      "@mokei/mcp-sqlite",
      "C:/Users/Khashayar/Documents/TamashaRoom/database/database.sqlite"
    ]
  },
  // Fetch — external docs (Pusher, Apinator). Built-in webfetch covers this;
  // @modelcontextprotocol/server-fetch does not exist on npm (404). Kept disabled.
  // Use OpenCode's webfetch tool for URL fetching. Brave Search requires API key — ask first.
  "fetch": {
    "type": "local",
    "enabled": false,
    "command": [
      "npx",
      "-y",
      "@modelcontextprotocol/server-fetch"
    ]
  }
},
  "$schema": "https://opencode.ai/config.json",

  // Provider setup:
  //   - DeepSeek direct is the ONLY provider used (the actual coding API).
  //     OpenRouter, 9Router, Zyloo and NVIDIA are intentionally NOT configured.
  //   - The key is the existing local environment variable DEEPSEEK_API_KEY
  //     (auto-detected by OpenCode) — nothing secret is hard-coded here.
  //   - No skills are listed here: skills are discovered dynamically via the
  //     AGENTS.md -> skill -> agent-selection flow, never a hard-coded list.
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash",

  "agent": {
    // OpenCode implementation agent (docs/ai/workflow role): executes
    // approved plans with full write access. DeepSeek direct.
    "implementer": {
      "description": "OpenCode implementation agent (docs/ai/workflow): executes approved plans with full write access.",
      "mode": "all",
      "model": "deepseek/deepseek-v4-flash"
    },
    // Desktop-AI audit/verification role (docs/ai/workflow): strictly
    // read-only inspection of the local codebase — edit denied, bash asks.
    "desktop-ai": {
      "description": "Desktop-AI audit/verification role (docs/ai/workflow): read-only inspection of the local codebase; never edits files.",
      "mode": "all",
      "model": "deepseek/deepseek-v4-flash",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  }
}
