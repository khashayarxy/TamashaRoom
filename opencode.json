{
  "$schema": "https://opencode.ai/config.json",

  // Provider setup:
  //   - DeepSeek direct is the ONLY provider used (the actual coding API).
  //     OpenRouter, 9Router, Zyloo and NVIDIA are intentionally NOT configured.
  //   - The key is the existing local environment variable DEEPSEEK_API_KEY
  //     (auto-detected by OpenCode) — nothing secret is hard-coded here.
  //   - No skills are listed here: skills are discovered dynamically via the
  //     AGENTS.md -> skill -> agent-selection flow, never a hard-coded list.
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash",

  "agent": {
    // OpenCode implementation agent (docs/ai/workflow role): executes
    // approved plans with full write access. DeepSeek direct.
    "implementer": {
      "description": "OpenCode implementation agent (docs/ai/workflow): executes approved plans with full write access.",
      "mode": "all",
      "model": "deepseek/deepseek-v4-flash"
    },
    // Desktop-AI audit/verification role (docs/ai/workflow): strictly
    // read-only inspection of the local codebase — edit denied, bash asks.
    "desktop-ai": {
      "description": "Desktop-AI audit/verification role (docs/ai/workflow): read-only inspection of the local codebase; never edits files.",
      "mode": "all",
      "model": "deepseek/deepseek-v4-flash",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  }
}
