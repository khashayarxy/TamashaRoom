{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "lint": "eslint resources/js --max-warnings 4",
    "lint:fix": "eslint resources/js --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write 'resources/js/**/*.{ts,tsx,css}'",
    "format:check": "prettier --check 'resources/js/**/*.{ts,tsx,css}'",
    "prettier:check": "npm run format:check",
    "format:php": "php vendor/bin/pint",
    "check:docs": "node scripts/check-docs.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --config=tests/e2e/playwright.config.ts",
    "test:a11y": "npx playwright test --config=tests/a11y/playwright.config.ts",
    "test:a11y:edge": "npx playwright test --config=tests/a11y/playwright.edge.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@headlessui/react": "^2.0.0",
    "@inertiajs/react": "^2.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^18.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.12",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "laravel-vite-plugin": "^1.3.0",
    "postcss": "^8.4.31",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.21",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@videojs/react": "^10.0.0-beta.26",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns-jalali": "^4.4.0-0",
    "frimousse": "^0.3.0",
    "laravel-echo": "^2.4.0",
    "lucide-react": "^1.25.0",
    "pusher-js": "^8.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ziggy-js": "^2.6.3",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  }
}
