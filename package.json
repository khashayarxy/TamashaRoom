{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build && php artisan view:clear",
    "dev": "vite",
    "lint": "eslint resources/js --max-warnings 4",
    "lint:fix": "eslint resources/js --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write 'resources/js/**/*.{ts,tsx,css}'",
    "format:check": "prettier --check 'resources/js/**/*.{ts,tsx,css}'",
    "prettier:check": "npm run format:check",
    "format:php": "php vendor/bin/pint",
    "check:docs": "node scripts/check-docs.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --config=tests/e2e/playwright.config.ts",
    "test:a11y": "npx playwright test --config=tests/a11y/playwright.config.ts",
    "test:a11y:contrast": "npx playwright test contrast-a11y.spec.ts --config=tests/a11y/playwright.config.ts",
    "test:a11y:edge": "npx playwright test --config=tests/a11y/playwright.edge.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@headlessui/react": "^2.2.10",
    "@inertiajs/react": "^3.7.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "4.3.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "laravel-vite-plugin": "1.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "5.4.21",
    "vitest": "^4.1.11",
    "zod-validation-error": "^5.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@videojs/react": "^10.0.0-beta.31",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "frimousse": "^0.3.0",
    "laravel-echo": "^2.4.0",
    "lucide-react": "^1.33.0",
    "pusher-js": "^8.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "ziggy-js": "^2.6.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  }
}
