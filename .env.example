APP_NAME=TamashaRoom
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://tamasharoom.test
VITE_APP_URL=https://tamasharoom.test

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Active broadcast driver: 'pusher' or 'apinator'. Keep BROADCAST_CONNECTION=null
# in CI/CI-like environments so broadcasting is a no-op and the frontend hooks
# fall back to polling. Set BROADCAST_CONNECTION=pusher (or apinator) and fill
# the matching credentials in locally/production.
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Mirrors BROADCAST_CONNECTION for the Vite-side Echo client.
VITE_BROADCAST_CONNECTION=null

# Pusher (active) - hosted real-time.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# Vite-side (public) Pusher settings for the Echo client.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=ap1
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=
VITE_PUSHER_SCHEME=https

# Apinator (backup - activate by setting BROADCAST_CONNECTION=apinator and
# VITE_BROADCAST_CONNECTION=apinator). Pusher-compatible endpoint; no client
# SDK change needed. See docs/ai/DECISION_LOG.md DECISION-015.
APINATOR_APP_KEY=
APINATOR_APP_SECRET=
APINATOR_HOST=api.apinator.io
APINATOR_PORT=443

# Vite-side (public) Apinator settings for the Echo client.
VITE_APINATOR_APP_KEY=
VITE_APINATOR_HOST=api.apinator.io

CACHE_STORE=file
# CACHE_PREFIX=

# Mail — Resend is the production driver (built into Laravel, SDK required).
# Replace RESEND_KEY with your real Resend API key (https://resend.com/api-keys).
MAIL_MAILER=resend
RESEND_KEY=
MAIL_FROM_ADDRESS="noreply@tamasharoom.ir"
MAIL_FROM_NAME="TamashaRoom"

# Maximum concurrent rooms across all users (hard ceiling for the single-core
# polling budget — see config/tamasharoom.php)
# TAMASHAROOM_MAX_CONCURRENT_ROOMS=50

# Sentry error monitoring (production only)
# Set SENTRY_DSN to enable; leave empty to disable.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_SAMPLE_RATE=1.0

VITE_APP_NAME="${APP_NAME}"
