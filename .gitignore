# Local junctions pointing to the real, tracked skill content in `.skills/`.
# Regenerate after a fresh clone (run from the project root):
#   New-Item -ItemType Junction -Path .opencode/skills -Target .skills
#   New-Item -ItemType Junction -Path .agents/skills   -Target .skills
.opencode/skills
.agents/skills

